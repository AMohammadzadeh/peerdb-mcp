# PeerDB Flow REST gateway, not the UI or gRPC port.
PEERDB_URL=http://localhost:8113
# Optional OAuth bearer token; inject securely. This file is not loaded automatically.
PEERDB_TOKEN=
# Alternatively, use Basic authentication (both required); leave PEERDB_TOKEN unset.
PEERDB_USERNAME=
PEERDB_PASSWORD=
PEERDB_TIMEOUT_SECONDS=30
# Disable create/pause/resume/update when operating as a monitoring-only server.
PEERDB_READ_ONLY=false
